  "about": {
    "title": "About",
    "mission": "Our mission",
    "missionText": "The Reformed Evangelical Church La Chapelle is a Christian community committed to serving the people of the Cévennes. Our mission is to welcome everyone, share God's love, and build a community founded on faith, hope, and charity.",
    "vision": "Our vision",
    "visionText": "We aspire to be a place of refuge and spiritual renewal in the Cévennes, where every person can discover their place in God's family, grow in faith, and serve others with love.",
    "history": "Our history",
    "historyText": "Born from a vision to gather believers in the Cévennes region, our church established itself in Saint-Hippolyte-du-Fort. Since our beginnings, we have grown as a multicultural and multilingual community, welcoming people from all walks of life.",
    "faith": "Statement of faith",
    "faithText": "We believe in one God, creator of all things, revealed in three persons: the Father, the Son, and the Holy Spirit. We believe in the Bible as the Word of God, in Jesus Christ as the only Savior and Lord, and in the transformative power of the Holy Spirit.",
    "values": "Our values",
    "valuesText": "Unconditional welcome, authenticity, service, prayer, biblical teaching, fellowship, and engagement in the local community. These values guide each of our actions and decisions.",
